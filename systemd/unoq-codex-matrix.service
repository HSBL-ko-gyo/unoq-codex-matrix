# UNOQ_CODEX_MATRIX_SERVICE=1
[Unit]
Description=UNO Q Codex LED Matrix Status Daemon
Wants=arduino-router.service
After=arduino-router.service

[Service]
Type=simple
User=arduino
Group=arduino
Environment=HOME=/home/arduino
Environment=PATH=/home/arduino/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/unoq-codex-matrix/venv/bin/unoq-codex-matrixd --config /etc/unoq-codex-matrix/config.json
RuntimeDirectory=unoq-codex-matrix
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
